# =============================================================================
# OAN Backend Configuration (server-side)
# =============================================================================
# URL of the OAN backend API (amul-oan-api)
# The demo-ui server proxies token requests to this backend.
OAN_API_URL="http://localhost:8000"

# API key for the /api/auth/token-for-phone endpoint
# Must match the DEMO_UI_API_KEY configured on the OAN backend.
DEMO_UI_API_KEY="your-api-key-here"

# =============================================================================
# Frontend Configuration (Vite)
# =============================================================================
# Base URL of the OAN backend for direct frontend calls (if not proxied)
# Default: empty (same-origin, requests go to /api/... via proxy)
# VITE_OAN_API_BASE_URL=""

# API key exposed to frontend (for direct calls without proxy)
# VITE_DEMO_UI_API_KEY="your-api-key-here"

# Base URL for the chat application (fallback if backend doesn't return url)
# Default: https://dev-amulmitra.amul.com
VITE_CHAT_BASE_URL="https://dev-amulmitra.amul.com"

# =============================================================================
# Notes
# =============================================================================
#
# 1. The demo-ui no longer generates JWT tokens or calls PashuGPT APIs directly.
#    All farmer data fetching and JWT signing is handled by the OAN backend via
#    POST /api/auth/token-for-phone.
#
# 2. Environment Variable Naming:
#    - Variables prefixed with VITE_ are exposed to the frontend
#    - Variables without VITE_ prefix are only available server-side
#
# 3. Security:
#    - NEVER commit .env file to version control
#    - Keep DEMO_UI_API_KEY secret
